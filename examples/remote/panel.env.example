# 远程访问（Cloudflare Tunnel / frp / 其他出站隧道）用的启动环境示例。
#
# 用法：
#   set -a; . ./panel.env; set +a
#   exec plugin-panel
#
# 口令用哈希形态生成（口令不经过服务端，落盘只有 Argon2id）：
#   printf '%s' '<你的口令>' | plugin-panel hash-token
# 输出形如 prehash1:$argon2id$v=19$m=19456,t=2,p=1$...
# 注意：$ 在 shell 里会被展开，必须用单引号。

PANEL_TOKEN_HASH='prehash1:$argon2id$v=19$m=19456,t=2,p=1$...'

# 面板仍然只绑回环：隧道进程（cloudflared / frpc）在本机连过来。
BIND_ADDR=127.0.0.1:8787

# 浏览器访问的是 https://<你的域名>，会话 cookie 必须带 Secure。
PANEL_COOKIE_SECURE=1

# 只信任本机回环来的转发头（cloudflared / nginx 都跑在本机）。
# 这样登录退避、蜜罐封禁、会话列表按真实客户端 IP 记账，而不是所有人在
# 127.0.0.1 这一个桶里互相牵连。
PANEL_TRUSTED_PROXIES=127.0.0.1,::1

# 可选：给自己留一条「不会被封死」的路（填你常用的出口 IP）。
# 它只豁免封禁与退避，口令错了照样进不来。
# PANEL_ALLOW_IPS=203.0.113.10

# 可选：只有开了插件页隔离才需要。浏览器会去连这个 origin，
# 隧道里要给 8788 再加一条 ingress + 一个域名（见 cloudflared.yml）。
# PLUGIN_UI=1
# PLUGIN_UI_ORIGIN=https://plugins.example.com
